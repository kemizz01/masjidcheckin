# ---------------------------------------------------------------------------
# MasjidCheckIn — environment variables
# Copy this file to `.env.local` and fill in your real Supabase credentials.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser) — used by lib/supabase.ts on the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only secret — used ONLY inside Route Handlers / serverless functions.
# Never reference this with the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
